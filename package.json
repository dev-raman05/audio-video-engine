{
  "name": "kaleidosync",
  "version": "1.1.0",
  "description": "Cross-platform (Windows, macOS, Linux) audio-reactive WebGL2 kaleidoscope visualizer",
  "homepage": "https://github.com/dev-raman05/audio-video-engine",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder",
    "dist:local": "electron-builder --win dir -c.electronDist=node_modules/electron/dist",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64",
    "dist:linux": "electron-builder --linux AppImage deb --x64"
  },
  "author": "Raman Mishra <yoraman31@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-raman05/audio-video-engine.git"
  },
  "build": {
    "appId": "com.raman.kaleidosync",
    "productName": "KaleidoSync",
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "KaleidoSync-Windows-Setup.exe"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": "-",
      "artifactName": "KaleidoSync-macOS-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "KaleidoSync analyzes audio input locally when Microphone or Line-In source is selected.",
        "NSScreenCaptureUsageDescription": "KaleidoSync uses macOS system audio capture to react to music playing on your Mac. No screen video is recorded or sent anywhere."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo;Music;",
      "maintainer": "Raman Mishra <yoraman31@gmail.com>",
      "synopsis": "Audio-reactive WebGL2 kaleidoscope visualizer",
      "artifactName": "KaleidoSync-Linux-x64.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  }
}
