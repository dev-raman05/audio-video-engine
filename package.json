{
  "name": "kaleidosync",
  "version": "1.0.0",
  "description": "Standalone Windows audio-reactive WebGL2 visualizer using WASAPI loopback",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder --win dir"
  },
  "author": "Yoram",
  "license": "MIT",
  "build": {
    "appId": "com.yoram.kaleidosync",
    "productName": "KaleidoSync",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  }
}
